{
  "name": "mini-backend-db-project",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace apps/backend\" \"npm run dev --workspace apps/web\"",
    "dev:backend": "npm run dev --workspace apps/backend",
    "dev:web": "npm run dev --workspace apps/web",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
